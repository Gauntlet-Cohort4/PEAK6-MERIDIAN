{
  "name": "meridian",
  "version": "0.1.0",
  "private": true,
  "description": "Solana binary options prediction market",
  "workspaces": [
    "shared",
    "automation",
    "app"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write '**/*.{ts,tsx,json,md}'",
    "format:check": "prettier --check '**/*.{ts,tsx,json,md}'",
    "test": "vitest run --workspace=vitest.workspace.ts",
    "test:watch": "vitest --workspace=vitest.workspace.ts",
    "test:shared": "npm run test --workspace=shared",
    "clean": "rm -rf node_modules shared/node_modules automation/node_modules app/node_modules"
  },
  "dependencies": {
    "@coral-xyz/anchor": "^0.30.1",
    "@ellipsis-labs/phoenix-sdk": "^2.0.3",
    "@solana/spl-token": "^0.4.14",
    "@solana/web3.js": "^1.98.4"
  },
  "overrides": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^8.57.0",
    "mocha": "^11.7.5",
    "prettier": "^3.3.0",
    "ts-mocha": "^11.1.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.0",
    "vitest": "^2.1.9"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
