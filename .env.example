# ============================================================
# Meridian Environment Variables
# ============================================================

# --- Solana RPC ---
# Devnet (free): https://api.devnet.solana.com
# Production: Get from Helius (https://helius.dev) or QuickNode (https://quicknode.com)
SOLANA_RPC_URL=https://api.devnet.solana.com

# --- Admin Keypair ---
# Path to Solana keypair JSON file for admin operations
# Generate with: solana-keygen new --outfile ~/.config/solana/meridian-admin.json
ADMIN_KEYPAIR_PATH=~/.config/solana/id.json

# --- Meridian Program ID ---
MERIDIAN_PROGRAM_ID=AiG9ZAw6625w5zUQRsfmWwqXRmYSZAJe9MRfjcJoEK9h

# --- Pyth Oracle ---
# Free endpoints (no key required):
#   Hermes: https://hermes.pyth.network
#   Benchmarks: https://benchmarks.pyth.network
# Get key at: https://pyth.network/developers (if rate-limited)
PYTH_HERMES_URL=https://hermes.pyth.network
PYTH_BENCHMARKS_URL=https://benchmarks.pyth.network

# --- Finnhub API ---
# Get free key at: https://finnhub.io/register
FINNHUB_API_KEY=your_finnhub_api_key_here

# --- Phoenix Legacy DEX ---
PHOENIX_PROGRAM_ID=PhoeNiXZ8ByJGLkxNfZRnkUfjvmuYqLR89jjFHGqdXY

# --- Demo Mode ---
# Set to 'true' to use mock data instead of real APIs
DEMO_MODE=false

# --- Automation Cron Schedules (ET timezone) ---
CRON_MORNING_SCHEDULE=0 8 * * 1-5
CRON_SETTLEMENT_SCHEDULE=5 16 * * 1-5

# --- Next.js Frontend ---
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
NEXT_PUBLIC_MERIDIAN_PROGRAM_ID=AiG9ZAw6625w5zUQRsfmWwqXRmYSZAJe9MRfjcJoEK9h
NEXT_PUBLIC_USDC_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU
NEXT_PUBLIC_PYTH_HERMES_URL=https://hermes.pyth.network
NEXT_PUBLIC_DEMO_MODE=false

# --- Debug Flags (set to 'true' to enable) ---
MERIDIAN_DEBUG_PHOENIX_INTEROP=false
MERIDIAN_DEBUG_ADAPTERS=false
MERIDIAN_DEBUG_TX=false
MERIDIAN_DEBUG_ORACLE=false
MERIDIAN_DEBUG_CRON=false
MERIDIAN_DEBUG_ORDERBOOK=false
MERIDIAN_DEBUG_ALL=false
